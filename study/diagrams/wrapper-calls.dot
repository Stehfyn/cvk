digraph repository {
graph [rankdir=TB, bgcolor="#f8fafc", pad=.5, nodesep=.35, ranksep=.8, fontname="Segoe UI", fontsize=20, labelloc=t, compound=true, outputorder=edgesfirst, splines=polyline, nslimit=2, nslimit1=2, mclimit=.2, remincross=false];
node [shape=box, style="rounded,filled", fillcolor=white, fontname="Segoe UI", fontsize=11, margin=".15,.1", penwidth=1.4];
edge [color="#94a3b8", arrowsize=.65, fontname="Segoe UI", fontsize=9];
label="Whole-repository wrapper call reference\nCaller to callee / both profiles and tests / every relationship contributes. Counts are static relationships, not execution frequency.";
subgraph cluster_cvk {
label="cvk"; color="#cbd5e1";
"cvk-3" [label="cvk / Tier 3\n56 functions or endpoints",color="#a855f7",id="cvk-3",URL="wrapper-calls-full.svg#cvkAllocateArena"];
