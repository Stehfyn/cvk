"cvk-3" -> "cvk-2" [style="invis",weight="100"];
"cvk-1p" [label="cvk / Tier 1'\n189 functions or endpoints",color="#0891b2",id="cvk-1p",URL="wrapper-calls-full.svg#cvkAcquireNextImageIndefinitely"];
