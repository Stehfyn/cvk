<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Native analysis must see fresh compiler state in selected-file builds too. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <MinimalRebuild>false</MinimalRebuild>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Keep owned-source native diagnostics visible even when a later gate
       prevents linking. Retain the SDK/external exclusions requested by the user. -->
  <Target Name="CastKeepNativeAnalysisVisible" BeforeTargets="ClCompile">
    <ItemGroup>
      <ClCompile>
        <PREfastAdditionalOptions>$([System.Text.RegularExpressions.Regex]::Replace('%(ClCompile.PREfastAdditionalOptions)', '(^|;)quiet(?=;|$)', '').Trim(';'))</PREfastAdditionalOptions>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
