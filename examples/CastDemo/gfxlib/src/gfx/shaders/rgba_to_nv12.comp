#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D rgba_source;
layout(std430, set = 0, binding = 1) writeonly buffer Nv12Output {
    uint words[];
} nv12;

layout(push_constant) uniform FrameInfo {
    uint width;
    uint height;
    uint y_stride_words;
    uint uv_offset_words;
    uint uv_stride_words;
} frame;

float bt709_limited_y(vec3 rgb)
{
    return clamp(0.0627451 + dot(rgb, vec3(0.182586, 0.614231, 0.062007)),
                 0.0, 1.0);
}

vec2 bt709_limited_uv(vec3 rgb)
{
    return clamp(vec2(0.501961 + dot(rgb, vec3(-0.100644, -0.338572, 0.439216)),
                      0.501961 + dot(rgb, vec3( 0.439216, -0.398942, -0.040274))),
                 vec2(0.0), vec2(1.0));
}

void main()
{
    uint x = gl_GlobalInvocationID.x * 4u;
    uint y = gl_GlobalInvocationID.y * 2u;
    if (x >= frame.width || y >= frame.height) {
        return;
    }

    vec3 top[4];
    vec3 bottom[4];
    for (uint i = 0u; i < 4u; ++i) {
        uint sample_x = min(x + i, frame.width - 1u);
        top[i] = texelFetch(rgba_source, ivec2(sample_x, y), 0).rgb;
        bottom[i] = texelFetch(rgba_source,
                               ivec2(sample_x, min(y + 1u, frame.height - 1u)), 0).rgb;
    }

    uint word_x = x / 4u;
    nv12.words[y * frame.y_stride_words + word_x] =
        packUnorm4x8(vec4(bt709_limited_y(top[0]),
                          bt709_limited_y(top[1]),
                          bt709_limited_y(top[2]),
                          bt709_limited_y(top[3])));
    nv12.words[(y + 1u) * frame.y_stride_words + word_x] =
        packUnorm4x8(vec4(bt709_limited_y(bottom[0]),
                          bt709_limited_y(bottom[1]),
                          bt709_limited_y(bottom[2]),
                          bt709_limited_y(bottom[3])));

    vec2 uv0 = bt709_limited_uv((top[0] + top[1] + bottom[0] + bottom[1]) * 0.25);
    vec2 uv1 = bt709_limited_uv((top[2] + top[3] + bottom[2] + bottom[3]) * 0.25);
    nv12.words[frame.uv_offset_words +
               (y / 2u) * frame.uv_stride_words + word_x] =
        packUnorm4x8(vec4(uv0, uv1));
}
