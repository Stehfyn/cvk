---
# Enable the complete general-purpose C analysis families. C++-only checks in
# these families select their own language support; the database selects C.
# Project-specific LLVM/Google/FPGA policies and C++ modernization are not the
# coding standard for this repository. Approved exceptions are recorded below.
Checks: >
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -clang-analyzer-optin.performance.Padding
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
SystemHeaders: false
# The C pointer-indexing diagnostic is excluded for the counted-buffer APIs.
ExtraArgs: ['-Wno-padded', '-Wno-unsafe-buffer-usage']
CheckOptions:
  readability-identifier-length.MinimumParameterNameLength: 1
  readability-identifier-length.MinimumVariableNameLength: 1
FormatStyle: file
...
