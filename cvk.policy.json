{
  "core": "VK_VERSION_1_4",
  "extensions": "all",
  "platforms": [
    "win32",
    "xlib"
  ],
  "capacities": {
    "CVK_MAX_PHYSICAL_DEVICES": 32,
    "CVK_MAX_QUEUE_FAMILY_PROPERTIES": 64,
    "CVK_MAX_PROPERTIES": 512,
    "CVK_MAX_SURFACE_FORMATS": 64,
    "CVK_MAX_PRESENT_MODES": 16,
    "CVK_MAX_SWAPCHAIN_IMAGES": 16,
    "CVK_MAX_DISPLAYS": 32,
    "CVK_MAX_DRM_FORMAT_MODIFIERS": 64,
    "CVK_MAX_DRM_FORMAT_MODIFIER_PLANES": 4,
    "CVK_MAX_INSTANCE_EXTENSIONS": 64,
    "CVK_MAX_DESCRIPTOR_SET_BINDINGS": 64
  },
  "default_capacity": 64,
  "input_asserts": false,
  "role_overrides": {
    "vkGetExternalComputeQueueDataNV::params": "I",
    "vkSetGpaDeviceClockModeAMD::pInfo": "I"
  },
  "chains": {
    "cvkGetPhysicalDeviceMemoryTypeIndex": {
      "brief": "Returns the physical device's memory type index whose property flags equal the given flags exactly, or VK_INVALID.",
      "steps": [
        {
          "call": "cvkGetPhysicalDeviceMemoryProperties",
          "local": {
            "pMemoryProperties": "memory_properties"
          }
        },
        {
          "call": "cvkGetMemoryTypeIndex",
          "bind": {
            "memoryTypeCount": "memory_properties.memoryTypeCount",
            "pMemoryTypes": "memory_properties.memoryTypes"
          },
          "return": true
        }
      ]
    },
    "cvkGetPhysicalDeviceCompatibleMemoryTypeIndex": {
      "brief": "Returns the physical device's first memory type index whose property flags cover the required flags, or VK_INVALID.",
      "steps": [
        {
          "call": "cvkGetPhysicalDeviceMemoryProperties",
          "local": {
            "pMemoryProperties": "memory_properties"
          }
        },
        {
          "call": "cvkGetCompatibleMemoryTypeIndex",
          "bind": {
            "memoryTypeCount": "memory_properties.memoryTypeCount",
            "pMemoryTypes": "memory_properties.memoryTypes"
          },
          "return": true
        }
      ]
    },
    "cvkGetInstanceExtensionSupport": {
      "brief": "Reports whether the instance supports every required extension.",
      "ret": "VkBool32",
      "steps": [
        {
          "call": "cvkEnumerateInstanceExtensionProperties",
          "local": {
            "pProperties": "properties"
          },
          "into": "property_count"
        },
        {
          "call": "cvkGetExtensionsSupport",
          "bind": {
            "propertyCount": "property_count",
            "pProperties": "properties"
          },
          "return": true
        }
      ]
    },
    "cvkGetPhysicalDeviceExtensionSupport": {
      "brief": "Reports whether a physical device supports every required extension.",
      "ret": "VkBool32",
      "steps": [
        {
          "call": "cvkEnumerateDeviceExtensionProperties",
          "local": {
            "pProperties": "properties"
          },
          "into": "property_count"
        },
        {
          "call": "cvkGetExtensionsSupport",
          "bind": {
            "propertyCount": "property_count",
            "pProperties": "properties"
          },
          "return": true
        }
      ]
    },
    "cvkGetPhysicalDeviceQueueFamilyIndex": {
      "brief": "Returns the physical device's first queue family whose flags cover the required flags, or VK_INVALID.",
      "ret": "uint32_t",
      "steps": [
        {
          "call": "cvkGetPhysicalDeviceQueueFamilyProperties",
          "local": {
            "pQueueFamilyProperties": "queue_family_properties"
          },
          "into": "queue_family_property_count"
        },
        {
          "call": "cvkGetQueueFamilyIndex",
          "bind": {
            "propertyCount": "queue_family_property_count",
            "pProperties": "queue_family_properties"
          },
          "return": true
        }
      ]
    },
    "cvkGetPhysicalDeviceExternalImageImportSupport": {
      "brief": "Reports whether an image description can be imported through an external memory handle type, and whether only dedicated allocations are allowed.",
      "ret": "VkBool32",
      "inputs": [
        {
          "type": "const void*",
          "name": "pImageFormatInfoNext",
          "doc": "Optional extension chain for the image format query, or NULL"
        }
      ],
      "outputs": [
        {
          "type": "VkBool32",
          "name": "pDedicatedOnly"
        }
      ],
      "steps": [
        {
          "call": "cvkInitPhysicalDeviceExternalImageFormatInfo",
          "bind": {
            "pNext": "pImageFormatInfoNext"
          },
          "local": {
            "pInfo": "external_image_format_info"
          }
        },
        {
          "call": "cvkGetPhysicalDeviceExternalImageFormatProperties",
          "bind": {
            "pImageFormatInfoNext": "&external_image_format_info",
            "pExternalImageFormatPropertiesNext": "NULL"
          },
          "local": {
            "pExternalImageFormatProperties": "external_image_format_properties"
          }
        },
        {
          "set": {
            "pDedicatedOnly": "(external_image_format_properties.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_DEDICATED_ONLY_BIT) ? VK_TRUE : VK_FALSE"
          }
        },
        {
          "return": "(external_image_format_properties.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT) ? VK_TRUE : VK_FALSE"
        }
      ]
    },
    "cvkGetPhysicalDeviceExternalImageExportSupport": {
      "brief": "Reports whether an image description can be exported through an external memory handle type, and whether only dedicated allocations are allowed.",
      "ret": "VkBool32",
      "inputs": [
        {
          "type": "const void*",
          "name": "pImageFormatInfoNext",
          "doc": "Optional extension chain for the image format query, or NULL"
        }
      ],
      "outputs": [
        {
          "type": "VkBool32",
          "name": "pDedicatedOnly"
        }
      ],
      "steps": [
        {
          "call": "cvkInitPhysicalDeviceExternalImageFormatInfo",
          "bind": {
            "pNext": "pImageFormatInfoNext"
          },
          "local": {
            "pInfo": "external_image_format_info"
          }
        },
        {
          "call": "cvkGetPhysicalDeviceExternalImageFormatProperties",
          "bind": {
            "pImageFormatInfoNext": "&external_image_format_info",
            "pExternalImageFormatPropertiesNext": "NULL"
          },
          "local": {
            "pExternalImageFormatProperties": "external_image_format_properties"
          }
        },
        {
          "set": {
            "pDedicatedOnly": "(external_image_format_properties.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_DEDICATED_ONLY_BIT) ? VK_TRUE : VK_FALSE"
          }
        },
        {
          "return": "(external_image_format_properties.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT) ? VK_TRUE : VK_FALSE"
        }
      ]
    },
    "cvkAllocateImageMemory": {
      "brief": "Allocates memory sized and typed for a image.",
      "steps": [
        {
          "call": "cvkGetImageMemoryRequirements",
          "local": {
            "pMemoryRequirements": "memory_requirements"
          }
        },
        {
          "call": "cvkGetPhysicalDeviceCompatibleMemoryTypeIndex",
          "bind": {
            "memoryTypeBits": "memory_requirements.memoryTypeBits"
          },
          "into": "memory_type_index"
        },
        {
          "assert": "VK_INVALID != memory_type_index"
        },
        {
          "call": "cvkAllocateMemory",
          "bind": {
            "allocationSize": "memory_requirements.size"
          }
        }
      ]
    },
    "cvkAllocateBufferMemory": {
      "brief": "Allocates memory sized and typed for a buffer.",
      "steps": [
        {
          "call": "cvkGetBufferMemoryRequirements",
          "local": {
            "pMemoryRequirements": "memory_requirements"
          }
        },
        {
          "call": "cvkGetPhysicalDeviceCompatibleMemoryTypeIndex",
          "bind": {
            "memoryTypeBits": "memory_requirements.memoryTypeBits"
          },
          "into": "memory_type_index"
        },
        {
          "assert": "VK_INVALID != memory_type_index"
        },
        {
          "call": "cvkAllocateMemory",
          "bind": {
            "allocationSize": "memory_requirements.size"
          }
        }
      ]
    },
    "cvkSetupImage": {
      "brief": "Creates an image, allocates memory for it, and binds the memory.",
      "steps": [
        {
          "call": "cvkCreateImage"
        },
        {
          "call": "cvkAllocateImageMemory"
        },
        {
          "call": "cvkBindImageMemory",
          "bind": {
            "memoryOffset": "0"
          }
        }
      ]
    },
    "cvkSetupBuffer": {
      "brief": "Creates a buffer, allocates memory for it, and binds the memory.",
      "steps": [
        {
          "call": "cvkCreateBuffer"
        },
        {
          "call": "cvkAllocateBufferMemory"
        },
        {
          "call": "cvkBindBufferMemory",
          "bind": {
            "memoryOffset": "0"
          }
        }
      ]
    },
    "cvkSetupDeviceQueue": {
      "brief": "Creates a logical device with one queue of one family and retrieves that queue; every requested extension must be supported.",
      "inputs": [
        {
          "type": "const void*",
          "name": "pQueueNext",
          "doc": "Optional extension chain for VkDeviceQueueCreateInfo, or NULL"
        },
        {
          "type": "VkDeviceQueueCreateFlags",
          "name": "queueFlags",
          "doc": "VkDeviceQueueCreateInfo::flags"
        },
        {
          "type": "float",
          "name": "queuePriority",
          "doc": "Priority of the single queue, 0.0 through 1.0"
        }
      ],
      "steps": [
        {
          "call": "cvkGetPhysicalDeviceExtensionSupport",
          "bind": {
            "pLayerName": "NULL",
            "requiredExtensionCount": "enabledExtensionCount",
            "ppRequiredExtensionNames": "ppEnabledExtensionNames"
          },
          "into": "extensions_supported"
        },
        {
          "assert": "extensions_supported"
        },
        {
          "call": "cvkInitDeviceQueueCreateInfo",
          "local": {
            "pInfo": "device_queue_create_info"
          },
          "bind": {
            "pNext": "pQueueNext",
            "flags": "queueFlags",
            "queueCount": "1",
            "pQueuePriorities": "&queuePriority"
          }
        },
        {
          "call": "cvkCreateDevice",
          "bind": {
            "queueCreateInfoCount": "1",
            "pQueueCreateInfos": "&device_queue_create_info"
          }
        },
        {
          "call": "cvkGetDeviceQueue",
          "bind": {
            "queueIndex": "0"
          }
        }
      ]
    },
    "cvkCmdBindComputePipeline": {
      "brief": "Binds a compute pipeline.",
      "steps": [
        {
          "call": "cvkCmdBindPipeline",
          "bind": {
            "pipelineBindPoint": "VK_PIPELINE_BIND_POINT_COMPUTE"
          }
        }
      ]
    },
    "cvkCmdBindComputeDescriptorSets": {
      "brief": "Binds descriptor sets to the compute bind point.",
      "steps": [
        {
          "call": "cvkCmdBindDescriptorSets",
          "bind": {
            "pipelineBindPoint": "VK_PIPELINE_BIND_POINT_COMPUTE"
          }
        }
      ]
    },
    "cvkCmdPushComputeConstants": {
      "brief": "Pushes constants for the compute stage.",
      "steps": [
        {
          "call": "cvkCmdPushConstants",
          "bind": {
            "stageFlags": "VK_SHADER_STAGE_COMPUTE_BIT"
          }
        }
      ]
    },
    "cvkCmdImageQueueOwnershipBarrier": {
      "brief": "Records one image memory barrier, with queue family ownership transfer when the families differ.",
      "steps": [
        {
          "call": "cvkInitImageMemoryBarrier",
          "local": {
            "pInfo": "image_memory_barrier"
          }
        },
        {
          "call": "cvkCmdPipelineBarrier",
          "bind": {
            "memoryBarrierCount": "0",
            "pMemoryBarriers": "NULL",
            "bufferMemoryBarrierCount": "0",
            "pBufferMemoryBarriers": "NULL",
            "imageMemoryBarrierCount": "1",
            "pImageMemoryBarriers": "&image_memory_barrier"
          }
        }
      ]
    },
    "cvkCmdImageBarrier": {
      "brief": "Records one image memory barrier without ownership transfer.",
      "steps": [
        {
          "call": "cvkCmdImageQueueOwnershipBarrier",
          "bind": {
            "srcQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED",
            "dstQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED"
          }
        }
      ]
    },
    "cvkCmdAcquireImageFromExternal": {
      "brief": "Records the acquire half of an image ownership transfer from an external owner.",
      "steps": [
        {
          "call": "cvkCmdImageQueueOwnershipBarrier",
          "bind": {
            "srcStageMask": "VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT",
            "srcAccessMask": "0",
            "srcQueueFamilyIndex": "VK_QUEUE_FAMILY_EXTERNAL"
          }
        }
      ]
    },
    "cvkCmdReleaseImageToExternal": {
      "brief": "Records the release half of an image ownership transfer to an external owner.",
      "steps": [
        {
          "call": "cvkCmdImageQueueOwnershipBarrier",
          "bind": {
            "dstStageMask": "VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT",
            "dstAccessMask": "0",
            "dstQueueFamilyIndex": "VK_QUEUE_FAMILY_EXTERNAL"
          }
        }
      ]
    },
    "cvkCmdBufferQueueOwnershipBarrier": {
      "brief": "Records one buffer memory barrier, with queue family ownership transfer when the families differ.",
      "steps": [
        {
          "call": "cvkInitBufferMemoryBarrier",
          "local": {
            "pInfo": "buffer_memory_barrier"
          }
        },
        {
          "call": "cvkCmdPipelineBarrier",
          "bind": {
            "memoryBarrierCount": "0",
            "pMemoryBarriers": "NULL",
            "bufferMemoryBarrierCount": "1",
            "pBufferMemoryBarriers": "&buffer_memory_barrier",
            "imageMemoryBarrierCount": "0",
            "pImageMemoryBarriers": "NULL"
          }
        }
      ]
    },
    "cvkCmdBufferBarrier": {
      "brief": "Records one buffer memory barrier without ownership transfer.",
      "steps": [
        {
          "call": "cvkCmdBufferQueueOwnershipBarrier",
          "bind": {
            "srcQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED",
            "dstQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED"
          }
        }
      ]
    },
    "cvkCmdAcquireBufferFromExternal": {
      "brief": "Records the acquire half of a buffer ownership transfer from an external owner.",
      "steps": [
        {
          "call": "cvkCmdBufferQueueOwnershipBarrier",
          "bind": {
            "srcStageMask": "VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT",
            "srcAccessMask": "0",
            "srcQueueFamilyIndex": "VK_QUEUE_FAMILY_EXTERNAL"
          }
        }
      ]
    },
    "cvkCmdReleaseBufferToExternal": {
      "brief": "Records the release half of a buffer ownership transfer to an external owner.",
      "steps": [
        {
          "call": "cvkCmdBufferQueueOwnershipBarrier",
          "bind": {
            "dstStageMask": "VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT",
            "dstAccessMask": "0",
            "dstQueueFamilyIndex": "VK_QUEUE_FAMILY_EXTERNAL"
          }
        }
      ]
    },
    "cvkQueueSubmitCommandBuffer": {
      "brief": "Submits one command buffer.",
      "inputs": [
        {
          "type": "VkCommandBuffer",
          "name": "commandBuffer",
          "doc": "The command buffer to submit"
        }
      ],
      "steps": [
        {
          "call": "cvkQueueSubmitInfo",
          "bind": {
            "commandBufferCount": "1",
            "pCommandBuffers": "&commandBuffer"
          }
        }
      ]
    },
    "cvkQueuePresentImage": {
      "brief": "Presents one swapchain image.",
      "inputs": [
        {
          "type": "VkSwapchainKHR",
          "name": "swapchain",
          "doc": "Swapchain presenting the image"
        },
        {
          "type": "uint32_t",
          "name": "imageIndex",
          "doc": "Index of the swapchain image to present"
        }
      ],
      "steps": [
        {
          "call": "cvkQueuePresent",
          "bind": {
            "swapchainCount": "1",
            "pSwapchains": "&swapchain",
            "pImageIndices": "&imageIndex",
            "pResults": "NULL"
          },
          "return": true
        }
      ]
    },
    "cvkSetupCommandPool": {
      "brief": "Creates a command pool and allocates command buffers from it.",
      "steps": [
        {
          "call": "cvkCreateCommandPool"
        },
        {
          "call": "cvkAllocateCommandBuffers"
        }
      ]
    },
    "cvkCreateComputePipelineLayout": {
      "brief": "Creates a pipeline layout for the compute stage with at most one push constant range.",
      "inputs": [
        {
          "type": "uint32_t",
          "name": "pushConstantOffset",
          "doc": "Offset of the push constant range"
        },
        {
          "type": "uint32_t",
          "name": "pushConstantSize",
          "doc": "Size of the push constant range, zero for none"
        }
      ],
      "steps": [
        {
          "call": "cvkInitPushConstantRange",
          "local": {
            "pInfo": "push_constant_range"
          },
          "bind": {
            "stageFlags": "VK_SHADER_STAGE_COMPUTE_BIT",
            "offset": "pushConstantOffset",
            "size": "pushConstantSize"
          }
        },
        {
          "call": "cvkCreatePipelineLayout",
          "bind": {
            "pushConstantRangeCount": "(0 != pushConstantSize) ? 1u : 0u",
            "pPushConstantRanges": "&push_constant_range"
          }
        }
      ]
    },
    "cvkSetupComputePipeline": {
      "brief": "Creates a shader module, a compute pipeline layout, and a compute pipeline.",
      "inputs": [
        {
          "type": "const void*",
          "name": "pStageNext",
          "doc": "Optional extension chain for VkPipelineShaderStageCreateInfo, or NULL"
        },
        {
          "type": "VkPipelineShaderStageCreateFlags",
          "name": "stageFlags",
          "doc": "VkPipelineShaderStageCreateInfo::flags"
        },
        {
          "type": "const char*",
          "name": "pEntryPoint",
          "doc": "Entry point name of the compute shader"
        }
      ],
      "steps": [
        {
          "call": "cvkCreateShaderModule"
        },
        {
          "call": "cvkInitPipelineShaderStageCreateInfo",
          "local": {
            "pInfo": "pipeline_shader_stage_create_info"
          },
          "bind": {
            "pNext": "pStageNext",
            "flags": "stageFlags",
            "stage": "VK_SHADER_STAGE_COMPUTE_BIT",
            "module": "(*pShaderModule)",
            "pName": "pEntryPoint"
          }
        },
        {
          "call": "cvkCreateComputePipelineLayout"
        },
        {
          "call": "cvkCreateComputePipeline",
          "bind": {
            "stage": "pipeline_shader_stage_create_info",
            "layout": "(*pPipelineLayout)"
          }
        }
      ]
    },
    "cvkUpdateDescriptorSet": {
      "brief": "Writes one descriptor binding.",
      "steps": [
        {
          "call": "cvkInitWriteDescriptorSet",
          "local": {
            "pInfo": "write_descriptor_set"
          }
        },
        {
          "call": "cvkUpdateDescriptorSets",
          "bind": {
            "descriptorWriteCount": "1",
            "pDescriptorWrites": "&write_descriptor_set",
            "descriptorCopyCount": "0",
            "pDescriptorCopies": "NULL"
          }
        }
      ]
    },
    "cvkUpdateImageDescriptorSet": {
      "brief": "Writes one image descriptor.",
      "steps": [
        {
          "call": "cvkInitDescriptorImageInfo",
          "local": {
            "pInfo": "descriptor_image_info"
          }
        },
        {
          "call": "cvkUpdateDescriptorSet",
          "bind": {
            "descriptorCount": "1",
            "pImageInfo": "&descriptor_image_info",
            "pBufferInfo": "NULL",
            "pTexelBufferView": "NULL"
          }
        }
      ]
    },
    "cvkUpdateBufferDescriptorSet": {
      "brief": "Writes one buffer descriptor.",
      "steps": [
        {
          "call": "cvkInitDescriptorBufferInfo",
          "local": {
            "pInfo": "descriptor_buffer_info"
          }
        },
        {
          "call": "cvkUpdateDescriptorSet",
          "bind": {
            "descriptorCount": "1",
            "pImageInfo": "NULL",
            "pBufferInfo": "&descriptor_buffer_info",
            "pTexelBufferView": "NULL"
          }
        }
      ]
    },
    "cvkCreateTimestampQueryPool": {
      "brief": "Creates a timestamp query pool.",
      "steps": [
        {
          "call": "cvkCreateQueryPool",
          "bind": {
            "queryType": "VK_QUERY_TYPE_TIMESTAMP",
            "pipelineStatistics": "0"
          }
        }
      ]
    },
    "cvkGetQueryPoolResults64": {
      "brief": "Reads 64-bit query results into a tightly packed array.",
      "inputs": [
        {
          "type": "VkQueryResultFlags",
          "name": "flags",
          "doc": "Query result flags; VK_QUERY_RESULT_64_BIT is added"
        },
        {
          "type": "uint64_t*",
          "name": "pResults",
          "doc": "Receives queryCount 64-bit results"
        }
      ],
      "steps": [
        {
          "call": "cvkGetQueryPoolResults",
          "bind": {
            "dataSize": "(size_t)queryCount * sizeof(uint64_t)",
            "pData": "pResults",
            "stride": "sizeof(uint64_t)",
            "flags": "flags | VK_QUERY_RESULT_64_BIT"
          },
          "return": true
        }
      ]
    },
    "cvkCmdDispatchItems": {
      "brief": "Dispatches enough workgroups to cover an item count, given items per invocation and the local size.",
      "inputs": [
        {
          "type": "VkExtent3D",
          "name": "itemCount",
          "doc": "Items to cover"
        },
        {
          "type": "VkExtent3D",
          "name": "itemsPerInvocation",
          "doc": "Items each invocation handles"
        },
        {
          "type": "VkExtent3D",
          "name": "localSize",
          "doc": "Workgroup local size"
        }
      ],
      "steps": [
        {
          "call": "cvkCmdDispatch",
          "bind": {
            "groupCountX": "(itemCount.width + itemsPerInvocation.width * localSize.width - 1u) / (itemsPerInvocation.width * localSize.width)",
            "groupCountY": "(itemCount.height + itemsPerInvocation.height * localSize.height - 1u) / (itemsPerInvocation.height * localSize.height)",
            "groupCountZ": "(itemCount.depth + itemsPerInvocation.depth * localSize.depth - 1u) / (itemsPerInvocation.depth * localSize.depth)"
          }
        }
      ]
    },
    "cvkCmdDispatchComputeItems": {
      "brief": "Binds a compute pipeline, its descriptor sets, and push constants, then dispatches by items.",
      "inputs": [
        {
          "type": "uint32_t",
          "name": "pushConstantOffset",
          "doc": "Offset of the push constants"
        },
        {
          "type": "uint32_t",
          "name": "pushConstantSize",
          "doc": "Size of the push constants"
        },
        {
          "type": "const void*",
          "name": "pPushConstants",
          "doc": "Push constant bytes"
        }
      ],
      "steps": [
        {
          "call": "cvkCmdBindComputePipeline"
        },
        {
          "call": "cvkCmdBindComputeDescriptorSets"
        },
        {
          "call": "cvkCmdPushComputeConstants",
          "bind": {
            "offset": "pushConstantOffset",
            "size": "pushConstantSize",
            "pValues": "pPushConstants"
          }
        },
        {
          "call": "cvkCmdDispatchItems"
        }
      ]
    },
    "cvkCmdTransferBufferToImage": {
      "brief": "Copies every plane of a subresource from a linear buffer into an image, with barriers and no ownership transfer.",
      "steps": [
        {
          "call": "cvkCmdTransferBufferToImageQueueOwnership",
          "bind": {
            "bufferSrcQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED",
            "bufferDstQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED",
            "imageAcquireSrcQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED",
            "imageAcquireDstQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED",
            "imageSrcQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED",
            "imageDstQueueFamilyIndex": "VK_QUEUE_FAMILY_IGNORED"
          }
        }
